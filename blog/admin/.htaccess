# =========================
# Blog Admin Security Config
# =========================

# 1) Core Security Headers
<IfModule mod_headers.c>
    # XSS Protection
    Header always set X-XSS-Protection "1; mode=block"

    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Clickjacking Protection
    Header always set X-Frame-Options "DENY"

    # Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Basic Content Security Policy (CSP)
    # You can adjust as needed if external scripts are added later
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline';"
</IfModule>

# 2) Disable Directory Browsing
Options -Indexes

# 3) Protect Sensitive Files
<FilesMatch "\.(log|tmp|bak|json|backup|old)$">
    Require all denied
</FilesMatch>

# 4) Optional: HTTP Basic Authentication
# Uncomment and set the real server path to .htpasswd for extra security
# AuthType Basic
# AuthName "Blog Admin - Restricted Access"
# AuthUserFile /var/www/html/blog/admin/.htpasswd
# Require valid-user

# 5) Optional: IP Restriction (Uncomment and customize your IPs)
# <RequireAll>
#     Require ip 127.0.0.1
#     Require ip 192.168.1.0/24
#     # Add your public IP here
# </RequireAll>
