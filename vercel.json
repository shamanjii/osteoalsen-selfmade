{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "ignoreCommand": "bash -c 'if [ \"$VERCEL_GIT_COMMIT_MESSAGE\" == *\"[skip ci]\"* ]; then exit 0; else exit 1; fi'",
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=86400, stale-while-revalidate=172800"
        }
      ]
    },
    {
      "source": "/_next/image(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
